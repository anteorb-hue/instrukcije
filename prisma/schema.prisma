// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN
  PARENT
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW_TUTOR    // Tutor didn't show up
  NO_SHOW_STUDENT  // Student didn't show up
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum VideoProvider {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
}

enum EducationLevel {
  OSNOVNA_SKOLA
  SREDNJA_SKOLA
  FAKULTET
  OSTALO
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          UserRole  @default(STUDENT)
  avatar        String?
  phone         String?
  bio           String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Tutor specific fields
  tutorProfile  TutorProfile?

  // Student specific fields
  studentProfile StudentProfile?

  // Parent specific fields
  parentProfile ParentProfile?

  // Relations
  sentMessages      Message[]     @relation("SentMessages")
  receivedMessages  Message[]     @relation("ReceivedMessages")
  bookingsAsStudent Booking[]     @relation("StudentBookings")
  bookingsAsTutor   Booking[]     @relation("TutorBookings")
  reviews           Review[]      @relation("ReviewsGiven")
  receivedReviews   Review[]      @relation("ReviewsReceived")
  payments          Payment[]
  notifications     Notification[]
  favorites         Favorite[]
  userPoints        UserPoints?
  childrenAsParent  ParentChild[] @relation("ParentChildren")
  parentLinks       ParentChild[] @relation("ChildParent")

  // Learning Materials
  materials         Material[]
  materialViews     MaterialView[]
  materialDownloads MaterialDownload[]

  // Tests & Quizzes
  testsCreated      Test[]
  questionsCreated  Question[]
  testSubmissions   TestSubmission[]

  @@map("users")
}

model TutorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title             String
  hourlyRate        Float
  experience        Int      // years
  verified          Boolean  @default(false)
  videoIntroUrl     String?
  languages         String[] // JSON array of languages
  availableOnline   Boolean  @default(true)
  availableInPerson Boolean  @default(false)
  videoProviders    VideoProvider[] // Supported video platforms

  // Location
  city              String?
  address           String?
  country           String   @default("Hrvatska")

  // Education
  education         String   @db.Text
  certifications    String[] // JSON array

  // Statistics
  totalSessions     Int      @default(0)
  averageRating     Float    @default(0)
  responseTime      Int?     // in minutes

  // Subjects taught
  subjects          SubjectTaught[]

  // Education levels
  educationLevels   EducationLevel[]

  // Availability
  availability      Availability[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("tutor_profiles")
}

model StudentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  educationLevel    EducationLevel
  interests         String[] // JSON array
  learningGoals     String?  @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("student_profiles")
}

model ParentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional additional parent info
  occupation        String?
  emergencyContact  String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("parent_profiles")
}

model ParentChild {
  id              String   @id @default(cuid())

  parentId        String
  parent          User     @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)

  childId         String
  child           User     @relation("ChildParent", fields: [childId], references: [id], onDelete: Cascade)

  relationship    String?  // "Mother", "Father", "Guardian", etc.
  isPrimary       Boolean  @default(false)  // Primary contact for this child
  canBook         Boolean  @default(true)   // Can book sessions for child
  canViewProgress Boolean  @default(true)   // Can view child's progress

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([parentId, childId])
  @@map("parent_children")
  @@index([parentId])
  @@index([childId])
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  nameEn      String   // English name
  description String?  @db.Text
  icon        String?
  category    String   // Matematika, Jezici, Programiranje, etc.

  tutors      SubjectTaught[]
  bookings    Booking[]
  materials   Material[]
  tests       Test[]
  questions   Question[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subjects")
}

model SubjectTaught {
  id              String        @id @default(cuid())
  tutorProfileId  String
  tutorProfile    TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  subjectId       String
  subject         Subject       @relation(fields: [subjectId], references: [id])

  experienceYears Int           @default(0)

  @@unique([tutorProfileId, subjectId])
  @@map("subjects_taught")
}

model Availability {
  id              String        @id @default(cuid())
  tutorProfileId  String
  tutorProfile    TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  dayOfWeek       Int           // 0-6 (Sunday-Saturday)
  startTime       String        // HH:mm format
  endTime         String        // HH:mm format

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("availability")
}

model Booking {
  id              String          @id @default(cuid())

  studentId       String
  student         User            @relation("StudentBookings", fields: [studentId], references: [id])

  tutorId         String
  tutor           User            @relation("TutorBookings", fields: [tutorId], references: [id])

  subjectId       String
  subject         Subject         @relation(fields: [subjectId], references: [id])

  scheduledAt     DateTime
  duration        Int             // in minutes
  status          SessionStatus   @default(SCHEDULED)

  // Video session details
  videoProvider   VideoProvider   @default(ZOOM)
  meetingUrl      String?
  meetingId       String?
  meetingPassword String?

  // Session details
  notes           String?         @db.Text
  studentNotes    String?         @db.Text
  tutorNotes      String?         @db.Text

  // Pricing
  price           Float

  // Relations
  payment         Payment?
  review          Review?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("bookings")
}

model Payment {
  id              String        @id @default(cuid())

  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id])

  userId          String
  user            User          @relation(fields: [userId], references: [id])

  amount          Float
  currency        String        @default("EUR")
  status          PaymentStatus @default(PENDING)

  // Stripe details
  stripePaymentId String?
  stripeSessionId String?

  paidAt          DateTime?
  refundedAt      DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

model Review {
  id              String   @id @default(cuid())

  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id])

  reviewerId      String
  reviewer        User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])

  reviewedId      String
  reviewed        User     @relation("ReviewsReceived", fields: [reviewedId], references: [id])

  rating          Int      // 1-5
  comment         String?  @db.Text

  // Tutor-specific ratings
  communication   Int?     // 1-5
  expertise       Int?     // 1-5
  punctuality     Int?     // 1-5

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("reviews")
}

model Message {
  id          String   @id @default(cuid())

  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])

  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  content     String   @db.Text
  read        Boolean  @default(false)
  readAt      DateTime?

  // Attachments
  attachments String[] // JSON array of file URLs

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("messages")
}

model Notification {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // booking_confirmed, message_received, review_received, etc.
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  data      String?  @db.Text // JSON data

  createdAt DateTime @default(now())

  @@map("notifications")
}

model Favorite {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorId   String

  createdAt DateTime @default(now())

  @@unique([userId, tutorId])
  @@map("favorites")
}

// Rewards & Points System

enum UserTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  ELITE
}

enum PointTransactionType {
  EARNED
  SPENT
  PENALTY
  BONUS
  REFUND
}

enum RewardType {
  DISCOUNT
  VOUCHER
  FEATURED
  FREE_LESSON
  PREMIUM
  COMMISSION_DISCOUNT
}

model UserPoints {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalPoints     Int      @default(0)
  currentTier     UserTier @default(BRONZE)

  // Referral system
  referralCode    String   @unique
  referredBy      String?
  totalReferrals  Int      @default(0)

  // Relations
  transactions    PointTransaction[]
  rewards         UserReward[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_points")
}

model PointTransaction {
  id              String                @id @default(cuid())

  userPointsId    String
  userPoints      UserPoints            @relation(fields: [userPointsId], references: [id], onDelete: Cascade)

  points          Int
  type            PointTransactionType
  reason          String
  description     String?

  // Optional relations
  bookingId       String?
  reviewId        String?

  metadata        String?  @db.Text // JSON data for additional info

  createdAt       DateTime @default(now())

  @@map("point_transactions")
  @@index([userPointsId])
  @@index([createdAt])
}

model UserReward {
  id              String      @id @default(cuid())

  userPointsId    String
  userPoints      UserPoints  @relation(fields: [userPointsId], references: [id], onDelete: Cascade)

  type            RewardType
  title           String
  description     String?
  value           Float       // Numeric value (EUR, percentage, days, etc.)
  pointsCost      Int

  used            Boolean     @default(false)
  usedAt          DateTime?
  expiresAt       DateTime?

  metadata        String?     @db.Text // JSON data for additional info

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("user_rewards")
  @@index([userPointsId])
  @@index([used])
}

model RewardCatalog {
  id              String     @id @default(cuid())

  type            RewardType
  title           String
  description     String     @db.Text
  pointsCost      Int
  value           Float

  userRole        UserRole?  // TUTOR, STUDENT, or null for both
  active          Boolean    @default(true)
  limitPerUser    Int?       // Max times user can redeem this
  validDays       Int?       // How many days reward is valid after redemption

  icon            String?
  imageUrl        String?

  metadata        String?    @db.Text // JSON for additional config

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("reward_catalog")
  @@index([active])
  @@index([userRole])
}

// Learning Materials System

enum MaterialType {
  VIDEO
  PDF
  DOCUMENT
  PRESENTATION
  IMAGE
  AUDIO
  ARCHIVE
  OTHER
}

// Tests & Quizzes System

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  FILL_IN_BLANK
}

enum TestDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model Material {
  id          String       @id @default(cuid())

  // Owner
  tutorId     String
  tutor       User         @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  // Content
  title       String
  description String?      @db.Text
  type        MaterialType
  fileUrl     String       // URL to file (Cloudinary, S3, etc.)
  fileName    String       // Original filename
  fileSize    Int          // Size in bytes
  mimeType    String       // e.g., "application/pdf", "video/mp4"

  // Categorization
  subjectId   String?
  subject     Subject?     @relation(fields: [subjectId], references: [id])

  educationLevel EducationLevel?

  tags        MaterialTag[]

  // Visibility & Access
  isPublic    Boolean      @default(true)  // Public or private
  isFree      Boolean      @default(true)  // Free or paid
  price       Float?       // Price if paid

  // Metadata
  duration    Int?         // For videos/audio (in seconds)
  pageCount   Int?         // For PDFs/documents

  // Stats
  viewCount   Int          @default(0)
  downloadCount Int        @default(0)

  // Tracking
  views       MaterialView[]
  downloads   MaterialDownload[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("materials")
  @@index([tutorId])
  @@index([subjectId])
  @@index([type])
  @@index([isPublic])
  @@index([createdAt])
}

model MaterialTag {
  id         String   @id @default(cuid())

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  tag        String

  createdAt  DateTime @default(now())

  @@unique([materialId, tag])
  @@map("material_tags")
  @@index([tag])
}

model MaterialView {
  id         String   @id @default(cuid())

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  viewedAt   DateTime @default(now())

  // Analytics
  ipAddress  String?
  userAgent  String?

  @@map("material_views")
  @@index([materialId])
  @@index([userId])
  @@index([viewedAt])
}

model MaterialDownload {
  id           String   @id @default(cuid())

  materialId   String
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  downloadedAt DateTime @default(now())

  // Analytics
  ipAddress    String?
  userAgent    String?

  @@map("material_downloads")
  @@index([materialId])
  @@index([userId])
  @@index([downloadedAt])
}

// Tests & Quizzes Models

model Test {
  id              String          @id @default(cuid())

  // Owner
  tutorId         String
  tutor           User            @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  // Content
  title           String
  description     String?         @db.Text
  instructions    String?         @db.Text

  // Categorization
  subjectId       String?
  subject         Subject?        @relation(fields: [subjectId], references: [id])

  educationLevel  EducationLevel?
  difficulty      TestDifficulty  @default(MEDIUM)

  // Settings
  timeLimit       Int?            // in minutes, null = no time limit
  passingScore    Float           @default(60)  // percentage
  shuffleQuestions Boolean        @default(false)
  showCorrectAnswers Boolean      @default(true)
  allowRetake     Boolean         @default(true)
  maxAttempts     Int?            // null = unlimited

  // Visibility
  isPublic        Boolean         @default(false)
  isActive        Boolean         @default(true)

  // Relations
  questions       TestQuestion[]
  submissions     TestSubmission[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("tests")
  @@index([tutorId])
  @@index([subjectId])
  @@index([isPublic])
  @@index([isActive])
}

model Question {
  id              String          @id @default(cuid())

  // Owner (for question bank)
  tutorId         String
  tutor           User            @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  // Content
  questionText    String          @db.Text
  type            QuestionType
  points          Float           @default(1)

  // For multiple choice
  options         QuestionOption[]

  // For other types
  correctAnswer   String?         @db.Text  // For short answer, true/false, fill in blank

  // Explanation
  explanation     String?         @db.Text

  // Categorization
  subjectId       String?
  subject         Subject?        @relation(fields: [subjectId], references: [id])

  educationLevel  EducationLevel?
  difficulty      TestDifficulty  @default(MEDIUM)
  tags            String[]

  // Usage
  testsUsedIn     TestQuestion[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("questions")
  @@index([tutorId])
  @@index([subjectId])
  @@index([type])
}

model QuestionOption {
  id              String   @id @default(cuid())

  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionText      String   @db.Text
  isCorrect       Boolean  @default(false)
  order           Int      @default(0)

  createdAt       DateTime @default(now())

  @@map("question_options")
  @@index([questionId])
}

// Join table for Test <-> Question (allows reusing questions)
model TestQuestion {
  id              String   @id @default(cuid())

  testId          String
  test            Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  order           Int      @default(0)
  pointOverride   Float?   // Override default points for this specific test

  @@unique([testId, questionId])
  @@map("test_questions")
  @@index([testId])
  @@index([questionId])
}

model TestSubmission {
  id              String          @id @default(cuid())

  testId          String
  test            Test            @relation(fields: [testId], references: [id], onDelete: Cascade)

  studentId       String
  student         User            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Timing
  startedAt       DateTime        @default(now())
  submittedAt     DateTime?
  timeSpent       Int?            // in seconds

  // Grading
  score           Float?          // percentage
  pointsEarned    Float?
  pointsPossible  Float?
  passed          Boolean?

  // Grading status
  isGraded        Boolean         @default(false)
  gradedAt        DateTime?
  gradedBy        String?         // userId of grader (tutor)
  feedback        String?         @db.Text

  // Answers
  answers         SubmissionAnswer[]

  // Metadata
  attemptNumber   Int             @default(1)
  ipAddress       String?
  userAgent       String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("test_submissions")
  @@index([testId])
  @@index([studentId])
  @@index([isGraded])
  @@index([createdAt])
}

model SubmissionAnswer {
  id                String          @id @default(cuid())

  submissionId      String
  submission        TestSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId        String

  // Student's answer
  answerText        String?         @db.Text
  selectedOptionId  String?         // For multiple choice

  // Grading
  isCorrect         Boolean?
  pointsEarned      Float?
  pointsPossible    Float?
  feedback          String?         @db.Text

  createdAt         DateTime        @default(now())

  @@map("submission_answers")
  @@index([submissionId])
  @@index([questionId])
}
